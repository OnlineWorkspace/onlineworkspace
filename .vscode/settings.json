{
  "cSpell.words": [
    "booped",
    "caddyfile",
    "Electrobun",
    "ewsgit",
    "ghostty",
    "Landmarker",
    "onlineworkspace",
    "onnotice",
    "Renderable",
    "solidjs",
    "TOTP",
    "unmaximize"
  ],
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "deno.enable": true,
  "deno.disablePaths": [
    "node_modules/",
    "**/node_modules/",
  ],
  "deno.documentPreloadLimit": 400
}
