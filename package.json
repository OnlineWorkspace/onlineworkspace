{
  "name": "@onlineworkspace/workspaces",
  "type": "module",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/onlineworkspace/onlineworkspace"
  },
  "private": true,
  "scripts": {
    "dev": "bun --watch backend/src/index.ts",
    "start": "bun backend/src/index.ts",
    "dev-debug": "bun --inspect-brk backend/src/index.ts",
    "build-web": "bun --cwd web build",
    "uikit": "bun --cwd uikit-solid dev"
  },
  "dependencies": {
    "prettier": "^3.8.3",
    "typescript": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14"
  },
  "workspaces": ["backend", "web", "uikit-solid", "applications/*/web", "applications/*/frontend", "applications/*/server", "applications/*/backend"]
}
