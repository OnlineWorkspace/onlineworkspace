{
  "name": "@onlineworkspace/workspaces",
  "type": "module",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/onlineworkspace/workspace"
  },
  "scripts": {
    "dev": "deno --no-clear-screen instance/src/index.ts",
    "build-web": "deno --cwd instance/src/web build",
