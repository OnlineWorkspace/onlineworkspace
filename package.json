    "preinstall": "git pull --recurse-submodules"
  },
  "private": true,
  "dependencies": {
    "prettier": "^3.8.3",
    "typescript": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14"
  }
}
